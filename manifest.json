{
  "manifest_version": 3,
  "name": "Peacedone Recorder",
  "short_name": "Peacedone",
  "version": "0.5.0",
  "description": "Call notes from live captions in Google Meet, Teams and Zoom web — saved as a transcript on your computer. No audio, no cloud.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "nativeMessaging",
    "downloads.open"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://*.zoom.us/*",
    "https://*.zoom.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/wc/*",
        "https://*.zoom.com/wc/*"
      ],
      "js": [
        "src/selectors.js",
        "src/merge.js",
        "ui/mascot.js",
        "src/language.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Peacedone Recorder",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/mascot/*.png"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://*.zoom.com/*"
      ]
    }
  ]
}
